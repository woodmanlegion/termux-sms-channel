{
  "name": "openclaw-termux-channel",
  "version": "1.0.0",
  "description": "Unified Termux SMS/MMS channel plugin for OpenClaw — SMS receive/send, MMS receive/send, persisted high-water marks, hook stubs for media processing",
  "type": "module",
  "main": "index.js",
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "runtimeExtensions": [
      "./index.js"
    ],
    "channel": {
      "id": "termux-sms",
      "label": "SMS/MMS",
      "selectionLabel": "SMS/MMS (Termux)",
      "detailLabel": "Termux SMS/MMS",
      "markdownCapable": false
    },
    "compat": {
      "pluginApi": ">=2026.7.1"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  }
}
